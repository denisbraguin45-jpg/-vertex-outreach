# ─── Vertex Outreach · Environment ───────────────────────────────────────────
# Copy to .env and fill. NEVER commit .env or config/business.json.

# OpenAI (official SDK) — create a separate project key with Restricted scope.
# Set a hard monthly limit at platform.openai.com → Settings → Limits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FAST=gpt-4.1-nano
OPENAI_MONTHLY_BUDGET_USD=50

# Chrome DevTools Protocol — real browser of the operator, dedicated profile.
# Chrome 136+ refuses --remote-debugging-port on the DEFAULT profile:
# a dedicated CHROME_PROFILE_DIR is a requirement, not a preference.
# Keep the debug port on 127.0.0.1 — never 0.0.0.0.
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# Instagram official API (Meta Graph). Webhook requires an Instagram
# Professional account + approved Meta app (App Review) to receive
# messages from external users.
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# SQLite (source of truth for the MVP). Local Node.js — not serverless.
DATABASE_URL=./data/outreach.db

# Rhythm limits (account health — same discipline as a real SDR)
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
# Operating window in local time, 24h format
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# Simulation/dry-run layer: when true, browser and API sends are logged but
# never executed. The worker and panel show DRY-RUN mode clearly.
OUTREACH_DRY_RUN=true
