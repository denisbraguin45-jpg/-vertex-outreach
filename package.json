{
  "name": "vertex-outreach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "worker": "tsx src/worker/index.ts",
    "up": "concurrently -n painel,worker -c blue,magenta \"next dev -p 3300\" \"tsx src/worker/index.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/db/core.test.ts src/db/prospects.test.ts src/db/growth.test.ts src/features/conversations/handoff.test.ts src/features/intelligence/ai.test.ts",
    "e2e": "tsx scripts/e2e-simulation.ts",
    "check-env": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5",
    "next": "16.3.4",
    "openai": "^4.73.0",
    "playwright": "^1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
